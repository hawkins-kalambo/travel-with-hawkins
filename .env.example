# Supabase — NEXT_PUBLIC_* are safe to expose to the browser (anon key is
# subject to RLS); SUPABASE_SERVICE_ROLE_KEY bypasses RLS and must stay
# server-only.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Used to build absolute redirect/callback URLs server-side (e.g. OAuth,
# password reset emails) where there's no browser window.location to read.
NEXT_PUBLIC_APP_URL=https://www.travelwithhawkins.com
NEXT_PUBLIC_SITE_URL=https://www.travelwithhawkins.com

# Resend — outbound transactional email (booking confirmations, receipts).
RESEND_API_KEY=your_resend_api_key
# Where new-booking admin notifications are sent.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_sandbox_api_key
# Malawi number that gets a text when a live chat visitor asks for a human agent.
ADMIN_NOTIFICATION_PHONE=0989127308

# PayChangu (Standard Checkout) — server-only, never prefix with NEXT_PUBLIC_.
# Required. Bearer token used for POST /payment and GET /verify-payment/{tx_ref}.
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key
# Required. "Web secret key" from the PayChangu dashboard, used only to verify
# the HMAC-SHA256 "Signature" header on incoming webhooks — not the same key
# as PAYCHANGU_SECRET_KEY above.
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret
# Optional. Defaults to https://api.paychangu.com if unset.
PAYCHANGU_BASE_URL=https://api.paychangu.com

# Meta WhatsApp Cloud API — all values are server-only. The production bot
# remains disabled until business review, test-number setup, and deployment
# checks are complete.
WHATSAPP_BOT_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_a_long_random_verify_token
META_APP_SECRET=your_meta_app_secret
# Required and deliberately not hardcoded in application code (example only).
WHATSAPP_GRAPH_API_VERSION=vXX.X
# Comma-separated names that have actually been approved in WhatsApp Manager.
WHATSAPP_APPROVED_TEMPLATE_NAMES=

# Optional constrained intent classifier. Guided menus work without it.
# The compatible provider must implement a server-side chat-completions API.
WHATSAPP_AI_PROVIDER=
WHATSAPP_AI_BASE_URL=
WHATSAPP_AI_API_KEY=
WHATSAPP_AI_MODEL=
